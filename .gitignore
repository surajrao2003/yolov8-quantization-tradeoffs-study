# --- Intermediate build artifacts (not model checkpoints) ---
**/*_preprocessed.onnx

# =============================================================================
# Models: ignore bulk artifacts. Tracked defaults = YOLOv8n @ 640 per technique
# (regenerate yolov8s/m and 320/1280 with quantization_scripts). To version
# another file, add a matching `!path/to/file` after the block for that folder.
# =============================================================================

# --- Base PyTorch weights (Ultralytics .pt): one checkpoint ---
models/yolo_models/*
!models/yolo_models/yolov8n.pt

# --- ONNX: one file per precision family @ 640 (YOLOv8n) ---
models/onnx_quantized_models/**
!models/onnx_quantized_models/FP32_onnx_models/
models/onnx_quantized_models/FP32_onnx_models/**
!models/onnx_quantized_models/FP32_onnx_models/640/
models/onnx_quantized_models/FP32_onnx_models/640/**
!models/onnx_quantized_models/FP32_onnx_models/640/yolov8n_640.onnx

!models/onnx_quantized_models/FP16_onnx_models/
models/onnx_quantized_models/FP16_onnx_models/**
!models/onnx_quantized_models/FP16_onnx_models/640/
models/onnx_quantized_models/FP16_onnx_models/640/**
!models/onnx_quantized_models/FP16_onnx_models/640/yolov8n_640_fp16.onnx

!models/onnx_quantized_models/INT8_onnx_dynamic_quantized_models/
models/onnx_quantized_models/INT8_onnx_dynamic_quantized_models/**
!models/onnx_quantized_models/INT8_onnx_dynamic_quantized_models/640/
models/onnx_quantized_models/INT8_onnx_dynamic_quantized_models/640/**
!models/onnx_quantized_models/INT8_onnx_dynamic_quantized_models/640/yolov8n_640_dynamic_quantized.onnx

!models/onnx_quantized_models/INT8_onnx_static_quantized_models/
models/onnx_quantized_models/INT8_onnx_static_quantized_models/**
!models/onnx_quantized_models/INT8_onnx_static_quantized_models/640/
models/onnx_quantized_models/INT8_onnx_static_quantized_models/640/**
!models/onnx_quantized_models/INT8_onnx_static_quantized_models/640/yolov8n_640_static_quantized.onnx

